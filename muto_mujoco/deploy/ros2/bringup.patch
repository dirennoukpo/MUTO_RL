+  // the servo lag behind the 50 Hz commands.
+  if (servo_speed_ > 20) {
+    RCLCPP_WARN(logger_, "servo_speed=%u ms > one 50 Hz cycle: servos will lag the policy commands", servo_speed_);
   }
 
